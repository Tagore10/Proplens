# Database
# Local/dev default (no setup needed): SQLite
DATABASE_URL=sqlite:///./proplens.db
# Docker/production example (Postgres):
# DATABASE_URL=postgresql://proplens:proplens@db:5432/proplens

# Optional: enables real AI insights via Gemini. If unset, a deterministic
# rule-based insight generator is used instead — the app works fully without this.
GEMINI_API_KEY=

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
